{
  "name": "ambassador-referral-linker",
  "version": "1.2.0",
  "description": "Browser extension for Microsoft Learn Student Ambassadors that adds your Contributor ID to Microsoft links.",
  "type": "module",
  "scripts": {
    "test": "node --test",
    "build": "node scripts/build.js",
    "format": "prettier --write \"{src,scripts,manifests}/**/*.{js,html,json}\" \"tests/**/*.js\" \"*.{md,json}\"",
    "typecheck": "tsc --noEmit --allowJs --checkJs src/**/*.js"
  },
  "keywords": [
    "microsoft",
    "ambassador",
    "referral",
    "contributor"
  ],
  "author": "Thiago Kusal",
  "license": "MIT",
  "devDependencies": {
    "@types/chrome": "^0.2.7",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2"
  }
}
